// Craft Quest Reviews — multi-tenant schema
// Every table carries `shop` so one install can never see another store's data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon: pooled URL above, direct URL here for migrations
}

// Written by @shopify/shopify-app-session-storage-prisma. Do not rename.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  SPAM
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  shop        String // tenant key — filter EVERY query by this
  productId   String // Shopify numeric product id, as a string
  productTitle String?
  productHandle String?

  rating      Int // 1..5
  title       String?
  body        String       @db.Text
  authorName  String
  authorEmail String?

  verified    Boolean      @default(false) // matched to a real paid order
  orderId     String?
  status      ReviewStatus @default(PENDING)

  images      ReviewImage[]
  reply       String?      @db.Text // merchant's public response
  repliedAt   DateTime?

  helpfulCount Int         @default(0)
  ipHash      String? // hashed, for rate limiting — never store raw IPs
  locale      String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([shop, productId, status])
  @@index([shop, status, createdAt])
  @@index([shop, createdAt])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  width    Int?
  height   Int?

  @@index([reviewId])
}

// Cached aggregate per product, so the storefront never has to COUNT() live.
model ProductStats {
  shop        String
  productId   String
  average     Float  @default(0)
  count       Int    @default(0)
  star1       Int    @default(0)
  star2       Int    @default(0)
  star3       Int    @default(0)
  star4       Int    @default(0)
  star5       Int    @default(0)
  updatedAt   DateTime @updatedAt

  @@id([shop, productId])
  @@index([shop])
}

// Per-store settings, created on install.
model ShopSettings {
  shop             String   @id
  autoPublish      Boolean  @default(false)
  requireVerified  Boolean  @default(false)
  allowImages      Boolean  @default(true)
  maxImages        Int      @default(3)
  requestEmails    Boolean  @default(false)
  requestDelayDays Int      @default(7)
  brandColor       String   @default("#b8892b")
  installedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Post-purchase review invitations.
model ReviewRequest {
  id         String   @id @default(cuid())
  shop       String
  orderId    String
  productId  String
  email      String
  token      String   @unique // one-click link into the review form
  sendAt     DateTime
  sentAt     DateTime?
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@unique([shop, orderId, productId])
  @@index([shop, sendAt, sentAt])
}

// ============================================================================
// Frames module
// ============================================================================

enum FrameMode {
  PNG // overlay image drawn with border-image (corners never stretch)
  CSS // gradient recipe, for colours that don't have artwork yet
}

enum FrameRule {
  ALL
  COLLECTION
  TAG
  PRODUCT_TYPE
  PRODUCT
}

// One frame finish: "Silver", "Chocolate", "Walnut"…
model FrameStyle {
  id          String    @id @default(cuid())
  shop        String
  name        String
  // Variant option values that select this frame, e.g. ["Silver", "Chrome"].
  matchValues String[]
  mode        FrameMode @default(CSS)

  // PNG mode — overlay stored in the merchant's own Shopify Files
  overlayUrl    String?
  overlayFileId String?
  overlayWidth  Int?
  overlayHeight Int?
  // How much of the PNG, per side, is moulding (percent of the image).
  sliceTop      Float @default(10)
  sliceRight    Float @default(10)
  sliceBottom   Float @default(10)
  sliceLeft     Float @default(10)

  // CSS mode recipe
  face  String @default("linear-gradient(135deg,#2b2b2b,#141414 45%,#303030)")
  edge  String @default("#0a0a0a")
  inner String @default("#3a3a3a")

  // Shared
  thickness   Float   @default(5)   // moulding width, % of the frame's short side
  matEnabled  Boolean @default(true)
  matColor    String  @default("#f6f4ef")
  matWidth    Float   @default(5)
  swatchColor String  @default("#1c1c1c")
  swatchUrl   String?

  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, active, sort])
}

// A group of frame styles and the products it applies to.
model FrameSet {
  id         String    @id @default(cuid())
  shop       String
  name       String
  styleIds   String[]  // ordered list of FrameStyle ids
  rule       FrameRule @default(ALL)
  ruleValues String[]  // collection handles / tags / product types / product ids
  priority   Int       @default(0) // higher wins when several sets match
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shop, active, priority])
}

model FrameSettings {
  shop         String   @id
  sizeOption   String   @default("Size")
  colorOption  String   @default("Frame Colour")
  roomImageUrl String?
  showScale    Boolean  @default(true)
  publishedAt  DateTime?
  updatedAt    DateTime @updatedAt
}
